# WordPress core, plugins and dependencies. All of these are installed by
# `composer install` / `npm install` rather than tracked.
/core/
wp-content/plugins/
wp-content/mu-plugins/
wp-content/languages/
*wp-includes/
*wp-admin/
*vendor/
*node_modules/
xmlrpc.php

# Uploads, caches and backups: site content, not source.
wp-content/uploads/
wp-content/cache/
wp-content/updraft/
wp-content/debug.log
*.log

# Secrets and server config.
.env
salt.php
.htaccess
.well-known/

# Database dumps. These carry the wp_users table -- real email addresses and
# password hashes -- so they never belong in the repository.
*.sql
sql/

# Build output. `npm run build` regenerates everything under dist/, and the
# committed block stylesheets do not need their maps.
*dist/
*.css.map

# Editor state.
.vscode/
.idea/
