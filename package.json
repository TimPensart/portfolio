{
    "name": "tims-theme",
    "version": "1.0.0",
    "description": "A portfolio website built with WordPress.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TimPensart/portfolio.git"
    },
    "author": "Tim Pensart",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/TimPensart/portfolio/issues"
    },
    "homepage": "https://github.com/TimPensart/portfolio#readme",
    "scripts": {
        "sass": "sass --style=compressed --source-map --quiet wp-content/themes/tims-theme/src/styles/pages/:wp-content/themes/tims-theme/dist/styles/pages/",
        "sass:blocks": "node config/sass-blocks.js",
        "process:sass:blocks": "node config/echo \"Sass Blocks started\" -f 94 && npm --silent run sass:blocks && node config/echo \"Sass Blocks finished\" -f 94",
        "watch:sass:blocks": "nodemon --watch wp-content/themes/tims-theme/src/styles/blocks --ext scss --silent --quiet --exec \"npm-run-all process:sass:blocks\"",
        "js": "rollup --config config/rollup.config.mjs --no-sourcemap --silent",
        "process:sass": "node config/echo \"Sass started\" -f 94 && npm --silent run sass && node config/echo \"Sass finished\" -f 94",
        "process:js": "node config/echo \"JS started\" -f 95 && npm --silent run js && node config/echo \"JS finished\" -f 95",
        "watch:sass": "nodemon --watch wp-content/themes/tims-theme/src/styles/ --ext scss --silent --quiet --exec \"npm-run-all process:sass\"",
        "watch:js": "nodemon --watch wp-content/themes/tims-theme/src/scripts/ --ext js --silent --quiet --exec \"npm-run-all process:js\"",
        "dev": "run-p watch:sass watch:sass:blocks watch:js"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@popperjs/core": "^2.11.8",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^23.0.7",
        "@rollup/plugin-multi-entry": "^6.0.1",
        "@rollup/plugin-node-resolve": "^15.3.0",
        "@rollup/plugin-terser": "^0.1.0",
        "nodemon": "^3.1.11",
        "npm-run-all": "^4.1.5",
        "rollup": "^3.29.5",
        "rollup-plugin-folder-input": "^1.0.1",
        "sass": "^1.79.3"
    },
    "dependencies": {
        "@fancyapps/ui": "^4.0.31",
        "lenis": "^1.1.13",
        "p5": "^2.2.1",
        "rollup-plugin-postcss": "^4.0.2",
        "swiper": "^11.1.14"
    }
}
