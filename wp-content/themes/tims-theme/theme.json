{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                {
                    "color": "#778cd3",
                    "name": "Primary",
                    "slug": "primary"
                },
                {
                    "color": "#ffa569",
                    "name": "Secondary",
                    "slug": "secondary"
                },
                {
                    "color": "#b6f0a4",
                    "name": "Tertiary",
                    "slug": "tertiary"
                },
                {
                    "color": "#faf16e",
                    "name": "Quaternary",
                    "slug": "quaternary"
                },
                {
                    "color": "#fff",
                    "name": "White",
                    "slug": "white"
                },
                {
                    "color": "#1a1a1a",
                    "name": "Black",
                    "slug": "black"
                }
            ]
        },
        "layout": {
            "contentSize": "900px",
            "wideSize": "1200px"
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "Tiny",
                    "size": "10px",
                    "slug": "20"
                },
                {
                    "name": "X-Small",
                    "size": "20px",
                    "slug": "30"
                },
                {
                    "name": "Small",
                    "size": "30px",
                    "slug": "40"
                },
                {
                    "name": "Regular",
                    "size": "clamp(30px, 5vw, 50px)",
                    "slug": "50"
                },
                {
                    "name": "Large",
                    "size": "clamp(30px, 7vw, 70px)",
                    "slug": "60"
                },
                {
                    "name": "X-Large",
                    "size": "clamp(50px, 7vw, 90px)",
                    "slug": "70"
                },
                {
                    "name": "XX-Large",
                    "size": "clamp(70px, 10vw, 140px)",
                    "slug": "80"
                }
            ],
            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "typography": {
            "writingMode": true,
            "defaultFontSizes": false,
            "fluid": true,
            "fontSizes": [
                {
                    "fluid": false,
                    "name": "Small",
                    "size": "0.875rem",
                    "slug": "small"
                },
                {
                    "fluid": {
                        "max": "1.125rem",
                        "min": "1rem"
                    },
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "medium"
                },
                {
                    "fluid": {
                        "max": "2rem",
                        "min": "1.125rem"
                    },
                    "name": "Large",
                    "size": "1.38rem",
                    "slug": "large"
                },
                {
                    "fluid": {
                        "max": "3.2rem",
                        "min": "1.75rem"
                    },
                    "name": "Extra Large",
                    "size": "1.75rem",
                    "slug": "x-large"
                },
                {
                    "fluid": {
                        "max": "4.8rem",
                        "min": "2.15rem"
                    },
                    "name": "Extra Extra Large",
                    "size": "2.5rem",
                    "slug": "xx-large"
                }
            ],
            "fontFamilies": [
                {
                    "name": "Delight",
                    "slug": "delight",
                    "fontFamily": "Delight, sans-serif",
                    "fontFace": [
                        {
                            "src": ["file:./dist/fonts/delight-vf.ttf"],
                            "fontWeight": "100 200 300 400 500 600 700 800 900",
                            "fontStyle": "normal",
                            "fontFamily": "Delight"
                        }
                    ]
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "color": {
            "background": "var:preset|color|black",
            "text": "var:preset|color|white"
        },
        "typography": {
            "fontFamily": "Segoe UI, Helvetica, sans-serif",
            "fontWeight": "400",
            "lineHeight": "1.5"
        },
        "spacing": {
            "blockGap": "0",
            "padding": {
                "left": "var:preset|spacing|50",
                "right": "var:preset|spacing|50"
            }
        },
        "elements": {
            "caption": {
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "lineHeight": "1.4"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var:preset|font-size|xx-large"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var:preset|font-size|x-large"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var:preset|font-size|large"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var:preset|font-size|medium"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "letterSpacing": "0.5px"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "700",
                    "letterSpacing": "1.4px",
                    "textTransform": "uppercase"
                }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var:preset|font-family|delight",
                    "fontWeight": "600",
                    "lineHeight": "1",
                    "letterSpacing": "-0.1px"
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ],
    "customTemplates": [
        {
            "name": "page-home",
            "postTypes": ["page"],
            "title": "Page home"
        }
    ]
}
